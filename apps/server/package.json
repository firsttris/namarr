{
  "name": "@namarr/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run i18n && bunx --bun vite dev --port 8420",
    "build": "bun run i18n && bunx --bun vite build && bun build server.ts --target=bun --outfile=dist/entry.js && rm -rf dist/drizzle && cp -r ../../packages/db/drizzle dist/drizzle",
    "start": "bun run dist/entry.js",
    "e2e": "playwright test",
    "i18n": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide"
  },
  "dependencies": {
    "@namarr/core": "workspace:*",
    "@namarr/db": "workspace:*",
    "@namarr/providers": "workspace:*",
    "@tanstack/react-query": "^5",
    "@tanstack/react-router": "^1",
    "@tanstack/react-start": "^1",
    "@tanstack/react-virtual": "^3",
    "chokidar": "^5",
    "pino": "^10",
    "react": "^19",
    "react-dom": "^19",
    "yaml": "^2.9.1",
    "zod": "^4"
  },
  "devDependencies": {
    "@inlang/paraglide-js": "^2.25.4",
    "@inlang/plugin-message-format": "^4.4.4",
    "@playwright/test": "^1",
    "@tailwindcss/vite": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "tailwindcss": "^4",
    "vite": "^8"
  }
}
