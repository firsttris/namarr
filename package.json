{
  "name": "namarr",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/server dev",
    "build": "bun run --cwd apps/server build",
    "start": "bun run --cwd apps/server start",
    "test": "bun run i18n && bun --bun vitest run",
    "test:watch": "bun --bun vitest",
    "typecheck": "bun run i18n && tsc -p packages/core && tsc -p packages/providers && tsc -p packages/db && tsc -p apps/server",
    "corpus": "bun scripts/corpus.ts --verbose",
    "lint": "biome check .",
    "format": "biome check --write .",
    "e2e": "bun run --cwd apps/server build && bun run --cwd apps/server e2e",
    "release:patch": "npm version patch",
    "release:minor": "npm version minor",
    "release:major": "npm version major",
    "postversion": "git push --follow-tags",
    "i18n": "bun run --cwd apps/server i18n"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^26.6.3",
    "fast-check": "^4.10.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "@biomejs/biome": "^2.5.15",
    "yaml": "^2.9.1"
  }
}
