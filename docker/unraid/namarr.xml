<?xml version="1.0"?>
<Container version="2">
  <Name>namarr</Name>
  <Repository>ghcr.io/firsttris/namarr:latest</Repository>
  <Registry>https://github.com/firsttris/namarr/pkgs/container/namarr</Registry>
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/firsttris/namarr/issues</Support>
  <Project>https://github.com/firsttris/namarr</Project>
  <Overview>The self-hosted renamer for movies, series and anime: matching against TMDB, TheTVDB, TVmaze or AniDB with Plex, Jellyfin, Emby or Kodi naming, ReNamer-style rules for everything else, watch folders, a preview before every change and undo for all of it. After the first start, set up your folders under Settings.</Overview>
  <Category>MediaApp:Video Tools:</Category>
  <WebUI>http://[IP]:[PORT:8420]/</WebUI>
  <Icon>https://raw.githubusercontent.com/firsttris/namarr/main/apps/server/public/favicon.svg</Icon>
  <ExtraParams>--init</ExtraParams>
  <Config Name="WebUI" Target="8420" Default="8420" Mode="tcp" Description="Web UI port" Type="Port" Display="always" Required="true" Configurable="true">8420</Config>
  <Config Name="Config" Target="/config" Default="/mnt/user/appdata/namarr" Mode="rw" Description="Database and settings" Type="Path" Display="always" Required="true" Configurable="true">/mnt/user/appdata/namarr</Config>
  <Config Name="Data" Target="/data" Default="/mnt/user/data" Mode="rw" Description="Downloads and library" Type="Path" Display="always" Required="true" Configurable="true">/mnt/user/data</Config>
  <Config Name="Token" Target="NAMARR_TOKEN" Default="" Mode="" Description="Required: access token for the web UI and the API" Type="Variable" Display="always" Required="true" Configurable="true" Mask="true"></Config>
  <Config Name="PUID" Target="PUID" Default="99" Mode="" Description="User ID for written files (Unraid: 99 = nobody)" Type="Variable" Display="advanced" Required="false" Configurable="true">99</Config>
  <Config Name="PGID" Target="PGID" Default="100" Mode="" Description="Group ID (Unraid: 100 = users)" Type="Variable" Display="advanced" Required="false" Configurable="true">100</Config>
</Container>
