# namarr as a Podman Quadlet (systemd).
#
# Rootless (recommended): copy to ~/.config/containers/systemd/namarr.container.
# Rootful: copy to /etc/containers/systemd/namarr.container and set PUID/PGID below.
#
#   printf 'my-long-token' | podman secret create namarr-token -
#   mkdir -p ~/namarr/config
#   systemctl --user daemon-reload
#   systemctl --user start namarr
#   loginctl enable-linger $USER   # rootless: start after boot without a login

[Unit]
Description=namarr – media matching and rule-based renaming
Wants=network-online.target
After=network-online.target

[Container]
ContainerName=namarr
Image=ghcr.io/firsttris/namarr:latest
# `podman auto-update` pulls new images and restarts the service.
AutoUpdate=registry

PublishPort=8420:8420
Secret=namarr-token,type=env,target=NAMARR_TOKEN

# Rootless: container root already is your host user. A PUID would map to a subuid, and the
# files would belong to a foreign UID on the host. So leave it empty.
# Rootful: set e.g. PUID=1000 and PGID=1000 instead.
Environment=PUID=

# %h = home directory. :Z sets the SELinux label (Fedora/RHEL); harmless without SELinux.
# One mount for downloads and library, or one per folder (Volume=/mnt/movies:/movies, …).
Volume=%h/namarr/config:/config:Z
Volume=/mnt/data:/data:Z

[Service]
Restart=always
# On stop, a running job gets up to 10 s to finish the current file.
TimeoutStopSec=30

[Install]
WantedBy=default.target
